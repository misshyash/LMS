# Firebase Web App config (public, client-safe — see SETUP.md).
# Leave all VITE_FIREBASE_* values blank / omit this file entirely to run
# the app in Demo Mode with no backend at all.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Force Demo Mode even if Firebase config above is filled in.
VITE_DEMO_MODE=false

# Point the app at local Firebase emulators instead of production (for local dev).
VITE_USE_EMULATORS=false
